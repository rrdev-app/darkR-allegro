{
  "manifest_version": 3,
  "name": "darkR - allegro",
  "version": "1.0.0",
  "description": "Ciemny motyw w standardzie rrdev.app dla Allegro. Zero oślepiania w nocy.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.allegro.pl/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "darkr-allegro@rrdev.app",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}